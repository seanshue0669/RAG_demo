# ---------------------------------------------------------------------------
# Cloud RAG Security Demo — .gitignore
# ---------------------------------------------------------------------------

# Generated fake data (regenerated by scripts/seed.py).
# NOTE: data/prerecorded/ is intentionally NOT ignored — those JSON files are
# committed so the demo can run without re-running heavy pipelines.
data/generated/

# ChromaDB persistence
backend/vectordb/db_data/

# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual envs
.venv/
venv/
env/

# Environment files
.env
.env.*
!.env.example

# Secrets / keys
*.pem
*.key
*.crt
*.p12
secrets/
credentials*.json

# Frontend
node_modules/
dist/
build/
.next/
.cache/
.vite/

# Python build / dist artefacts
*.egg-info/
*.so
.eggs/

# Testing / coverage
.coverage
.coverage.*
htmlcov/
.tox/

# Jupyter
.ipynb_checkpoints/

# Claude Code — local-only settings (machine-specific perms, hooks, etc.)
.claude/

# Editor / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs
*.log
logs/
